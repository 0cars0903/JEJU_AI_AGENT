# Copy to .env only if you refresh data. Never commit, share or record real keys.
# Jeju Data Hub project key: needed only for app/collect_api.py (data refresh).
JEJU_DATAHUB_KEY=

# Optional. Claude is used per request only: a staff member logs in and presses [Claude로 분석] in expert mode.
# Without a key the app runs on local Ollama models and fixed plans.
# ANTHROPIC_API_KEY=
# Staff accounts for the Claude button (hash: python -m app.auth hash) and the cookie secret (python -m app.auth secret)
# JEJU_ACCOUNTS=staff1:<hash>
# JEJU_SESSION_SECRET=
# JEJU_CLAUDE=request       # request (default, staff per request) | auto (use Claude automatically when a key exists)

# Optional overrides
# LLM_BACKEND=ollama        # ollama | claude | rule
# JEJU_OLLAMA_MODEL=qwen3:1.7b
# JEJU_AGENT_MODEL=qwen2.5:7b
# OLLAMA_URL=http://localhost:11434/api/chat
